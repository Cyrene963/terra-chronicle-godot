[sub_resource type="GDScript" id="GDScript_card_reveal"]
script/source = "extends Control

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var card_container: SubViewportContainer = $CenterContainer/SubViewportContainer
@onready var card_face: TextureRect = $CenterContainer/SubViewportContainer/CardFace
@onready var card_name_label: Label = $CenterContainer/SubViewportContainer/CardFace/CardName
@onready var atk_label: Label = $CenterContainer/SubViewportContainer/CardFace/Stats/ATK
@onready var def_label: Label = $CenterContainer/SubViewportContainer/CardFace/Stats/DEF
@onready var element_label: Label = $CenterContainer/SubViewportContainer/CardFace/Element
@onready var hint_label: Label = $HintLabel

var card_data: Dictionary = {}

func _ready() -> void:
	# Start with card rotated 180 degrees (back facing)
	card_container.material.set_shader_parameter(\"rotation_y\", PI)
	card_container.material.set_shader_parameter(\"scale_factor\", 0.78)
	card_container.material.set_shader_parameter(\"translate_y\", 30.0)

	# Play flip animation
	animation_player.play(\"card_flip\")

func set_card_data(data: Dictionary) -> void:
	card_data = data
	if card_name_label:
		card_name_label.text = data.get(\"name\", \"Unknown Card\")
	if atk_label:
		atk_label.text = \"ATK: %d\" % data.get(\"atk\", 0)
	if def_label:
		def_label.text = \"DEF: %d\" % data.get(\"def\", 0)
	if element_label:
		element_label.text = data.get(\"element\", \"无\")

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		# Close and add card to deck
		queue_free()
"

[sub_resource type="Shader" id="Shader_card_3d"]
code = "shader_type canvas_item;

uniform float rotation_y = 0.0;
uniform float scale_factor = 1.0;
uniform float translate_y = 0.0;

void fragment() {
	// Apply 3D perspective transform
	vec2 uv = UV - 0.5;

	// Y rotation
	float cos_y = cos(rotation_y);
	float sin_y = sin(rotation_y);

	// Apply rotation
	float x = uv.x * cos_y;
	float z = uv.x * sin_y;

	// Perspective projection
	float perspective = 1.0 / (1.0 + z * 0.5);
	vec2 transformed_uv = vec2(x * perspective, uv.y) * scale_factor;

	// Apply Y translation
	transformed_uv.y += translate_y / 500.0;

	transformed_uv += 0.5;

	// Sample texture
	if (transformed_uv.x < 0.0 || transformed_uv.x > 1.0 || transformed_uv.y < 0.0 || transformed_uv.y > 1.0) {
		COLOR = vec4(0.0);
	} else {
		COLOR = texture(TEXTURE, transformed_uv);

		// Add drop shadow effect
		float shadow = smoothstep(0.0, 0.02, abs(z)) * 0.3;
		COLOR.rgb = mix(COLOR.rgb, vec3(0.0), shadow);
	}

	// Backface culling (show black when rotated past 90 degrees)
	if (cos_y < 0.0) {
		COLOR = vec4(0.1, 0.15, 0.2, COLOR.a);
	}
}
"

